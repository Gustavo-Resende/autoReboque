# Copie para .env e ajuste. O servidor lê o .env automaticamente se ele existir
# (variáveis já definidas no ambiente têm prioridade sobre o arquivo).

DATABASE_URL=postgres://autoreboque:autoreboque@localhost:5432/autoreboque?sslmode=disable
HTTP_ADDR=:8080

# Hash bcrypt da senha única de acesso. Gere com:  go run ./cmd/hashsenha
# Mantenha entre aspas simples: o hash tem cifrões, e sem aspas o Docker Compose
# tenta interpretar como variável.
# O valor abaixo corresponde à senha "trevo123" — troque antes de usar de verdade.
SENHA_HASH='$2a$10$OT/YwO8ma4j5W28V8kfw7u4uncWV.b/dee3wXEyAUckeGxSXSWYPS'

# Pasta onde ficam as imagens (fotos das OS e logo da empresa).
STORAGE_DIR=./dados/uploads

# Primeiro número que o sistema emite (para continuar de onde o controle em papel parou).
# Só vale para a primeira sequência criada; anos seguintes começam em 1.
OS_NUMERO_INICIAL=1

# Tamanho máximo por imagem enviada, em megabytes.
UPLOAD_MAX_MB=15

# Duração da sessão (formato do Go: 720h = 30 dias).
SESSAO_DURACAO=720h

# true quando o sistema estiver atrás de HTTPS (marca o cookie como Secure).
COOKIE_SECURE=false

# true em desenvolvimento: recarrega templates do disco a cada requisição.
DEV=true

# Usado apenas por `go test`. Aponte SEMPRE para um banco descartável.
TEST_DATABASE_URL=postgres://autoreboque:autoreboque@localhost:5432/autoreboque_test?sslmode=disable

# --- API nova (cmd/api) ---
# Origens do frontend permitidas no CORS, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173

# Usuário criado pelo seed (fase 1 do plano). Troque antes de usar de verdade.
SEED_ADMIN_EMAIL=admin@autoreboque.local
SEED_ADMIN_SENHA=trevo123
